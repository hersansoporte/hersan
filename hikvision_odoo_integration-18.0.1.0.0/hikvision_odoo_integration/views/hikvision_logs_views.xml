<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hikvision_logs_view_tree" model="ir.ui.view">
        <field name="name">hikvision.logs.view.tree</field>
        <field name="model">hikvision.logs</field>
        <field name="arch" type="xml">
            <list string="Attendance" create="false">
                <field name="employee_id"/>
                <field name="date"/>
                <field name="punch_type"/>
                <field name="attendance_type"/>
                <field name="punching_time"/>
            </list>
        </field>
    </record>

    <record id="hikvision_odoo_integration.hikvision_logs_action" model="ir.actions.act_window">
        <field name="name">Hikvision Logs</field>
        <field name="res_model">hikvision.logs</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_attendance_tree_hikvision_breaks" model="ir.ui.view">
        <field name="name">hr.attendance.list.hikvision.breaks</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='check_in']" position="after">
                <field name="almuerzo_out"/>
                <field name="almuerzo_in"/>
                <field name="comida_out"/>
                <field name="comida_in"/>
            </xpath>
            <xpath expr="(//field[@name='worked_hours' or @name='hik_worked_hours'])[1]" position="replace">
                <field name="break_hours" string="Tiempo de descanso" widget="float_time" sum="Total descanso"/>
                <field name="worked_hours" string="Tiempo trabajado" widget="float_time" sum="Total trabajado"/>
                <field name="total_hours" string="Tiempo total" widget="float_time" sum="Total general"/>
            </xpath>
        </field>
    </record>

    <record id="view_attendance_form_hikvision_breaks" model="ir.ui.view">
        <field name="name">hr.attendance.form.hikvision.breaks</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='check_out']" position="after">
                <field name="almuerzo_out"/>
                <field name="almuerzo_in"/>
                <field name="comida_out"/>
                <field name="comida_in"/>
            </xpath>
            <xpath expr="(//field[@name='worked_hours' or @name='hik_worked_hours'])[1]" position="replace">
                <field name="break_hours" string="Tiempo de descanso" widget="float_time"/>
                <field name="worked_hours" string="Tiempo trabajado" widget="float_time"/>
                <field name="total_hours" string="Tiempo total" widget="float_time"/>
            </xpath>
        </field>
    </record>
</odoo>